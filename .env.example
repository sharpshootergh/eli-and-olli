# Site Configuration
NEXT_PUBLIC_SITE_URL=https://your-wedding-domain.com

# Optional Couple Customization Overrides
# NEXT_PUBLIC_PARTNER_ONE_NAME=Elisha
# NEXT_PUBLIC_PARTNER_ONE_NICKNAME=Elisha
# NEXT_PUBLIC_PARTNER_ONE_FULL_NAME="Elisha Austin Sagoe"
# NEXT_PUBLIC_PARTNER_TWO_NAME=Olivia
# NEXT_PUBLIC_PARTNER_TWO_NICKNAME=Olivia
# NEXT_PUBLIC_PARTNER_TWO_FULL_NAME="Olivia Eunice Tokpa"

# Optional Story Video/Text Overrides
# NEXT_PUBLIC_STORY_VIDEO_TYPE=youtube
# NEXT_PUBLIC_STORY_YOUTUBE_URL=https://www.youtube.com/embed/your-video-id

# Supabase Credentials (Optional - Website works with local fallback state if unconfigured)
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Resend API Key for RSVP Confirmation Emails (Optional)
RESEND_API_KEY=re_your_resend_api_key

# Paystack Secret Key (Optional - for registry donations if enabled)
PAYSTACK_SECRET_KEY=sk_live_your_paystack_secret_key
