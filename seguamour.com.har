            "text": "<!DOCTYPE html><html lang=\"en\" class=\"cormorant_garamond_810611a8-module__E0HZvq__variable source_sans_3_26134156-module__OBZBPa__variable scroll-smooth\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"stylesheet\" href=\"/_next/static/chunks/2sxyep-vyrbyn.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/2zjueh7t2vecu.js\"/><script src=\"/_next/static/chunks/37v557e3mkxjp.js\" async=\"\"></script><script src=\"/_next/static/chunks/3gzxhq9iq6efl.js\" async=\"\"></script><script src=\"/_next/static/chunks/1tzlurlum1858.js\" async=\"\"></script><script src=\"/_next/static/chunks/27jktro2p5rq9.js\" async=\"\"></script><script src=\"/_next/static/chunks/turbopack-3_y-v2kvhaln1.js\" async=\"\"></script><script src=\"/_next/static/chunks/1hwbyymzduhm9.js\" async=\"\"></script><script src=\"/_next/static/chunks/3rxsc4xc2zpkk.js\" async=\"\"></script><script src=\"/_next/static/chunks/2-ad6ibyefww-.js\" async=\"\"></script><meta name=\"next-size-adjust\" content=\"\"/><title>You&#x27;re invited — Elisha &amp; Olivia</title><meta name=\"description\" content=\"Invitation to the weddings of Olivia Eunice Tokpa &amp; Elisha Austin Sagoe\"/><meta property=\"og:title\" content=\"Elisha &amp; Olivia — Our Wedding\"/><meta property=\"og:description\" content=\"Two celebrations · One love story\"/><meta property=\"og:url\" content=\"https://seguamour.com\"/><meta property=\"og:type\" content=\"website\"/><meta name=\"twitter:card\" content=\"summary\"/><meta name=\"twitter:title\" content=\"Elisha &amp; Olivia — Our Wedding\"/><meta name=\"twitter:description\" content=\"Two celebrations · One love story\"/><link rel=\"icon\" href=\"/favicon.ico?favicon.2vob68tjqpejf.ico\" sizes=\"256x256\" type=\"image/x-icon\"/><script src=\"/_next/static/chunks/0cz1d0mv5g_q7.js\" noModule=\"\"></script></head><body class=\"font-sans text-wedding-ink antialiased selection:bg-wedding-blue/20 flex flex-col min-h-screen\"><div hidden=\"\"><!--$--><!--/$--></div><div class=\"flex-1 flex flex-col min-h-screen\"><div class=\"invite-page relative min-h-screen flex flex-col items-center justify-center px-3 py-7 sm:px-6 sm:py-12 print:py-0 overflow-hidden\"><div class=\"invite-atmosphere pointer-events-none absolute inset-0 print:hidden\" aria-hidden=\"true\"></div><article class=\"invite-card relative z-10 w-full max-w-2xl print:shadow-none\"><div class=\"invite-pattern invite-pattern-top pointer-events-none\" aria-hidden=\"true\"></div><div class=\"invite-pattern invite-pattern-bottom pointer-events-none\" aria-hidden=\"true\"></div><div class=\"invite-side-motif invite-side-motif-left pointer-events-none\" aria-hidden=\"true\"><i></i><i></i><i></i><i></i></div><div class=\"invite-side-motif invite-side-motif-right pointer-events-none\" aria-hidden=\"true\"><i></i><i></i><i></i><i></i></div><div class=\"pointer-events-none absolute inset-3 border border-[#b98b2e]/60 print:inset-2\" aria-hidden=\"true\"></div><div class=\"pointer-events-none absolute inset-[18px] border border-[#142a50]/25 print:hidden\" aria-hidden=\"true\"></div><div class=\"invite-inner relative px-8 pt-20 pb-24 sm:px-20 sm:pt-24 sm:pb-28 text-center space-y-9\"><div class=\"invite-fade space-y-3\" style=\"animation-delay:0ms\"><p class=\"text-[10px] tracking-[0.34em] uppercase text-[#142a50]\">The Sagoe and Tokpa Families</p><p class=\"text-[10px] tracking-[0.28em] uppercase text-[#88714a]\">Two celebrations · One love</p></div><div class=\"invite-fade flex items-center justify-center gap-3\" style=\"animation-delay:100ms\" aria-hidden=\"true\"><span class=\"h-px w-14 bg-[#b98b2e]\"></span><span class=\"w-2 h-2 rotate-45 bg-[#b98b2e]\"></span><span class=\"h-px w-14 bg-[#b98b2e]\"></span></div><div class=\"invite-fade space-y-4\" style=\"animation-delay:180ms\"><h1 class=\"font-serif leading-[0.95] text-[#142a50]\"><span class=\"block text-4xl sm:text-6xl tracking-tight\">Olivia Eunice Tokpa</span><span class=\"block my-3 font-serif text-2xl sm:text-3xl text-[#b98b2e] font-light italic uppercase tracking-wider\">And</span><span class=\"block text-4xl sm:text-6xl tracking-tight\">Elisha Austin Sagoe</span></h1><p class=\"text-sm sm:text-[15px] text-[#5e5448] tracking-wide leading-relaxed max-w-md mx-auto font-light\">request the honor of your presence<br/>at their wedding celebrations</p></div><div class=\"invite-fade space-y-0\" style=\"animation-delay:280ms\"><div><div class=\"space-y-2 py-1\"><p class=\"text-[11px] tracking-[0.22em] uppercase text-[#142a50] font-semibold\">Traditional Wedding</p><p class=\"font-serif text-2xl sm:text-3xl text-[#142a50]\">Saturday, 12 December 2026</p><p class=\"text-sm text-[#403b35]\">12:00</p><p class=\"text-sm text-[#6b6154] tracking-wide\">Abidjan, Ivory Coast</p></div></div><div><div class=\"my-7 flex justify-center\" aria-hidden=\"true\"><span class=\"h-px w-12 bg-[#c9a866]\"></span></div><div class=\"space-y-2 py-1\"><p class=\"text-[11px] tracking-[0.22em] uppercase text-[#142a50] font-semibold\">White Wedding</p><p class=\"font-serif text-2xl sm:text-3xl text-[#142a50]\">Saturday, 19 December 2026</p><p class=\"text-sm text-[#403b35]\">12:00</p><p class=\"text-sm text-[#6b6154] tracking-wide\">Cape Coast, Ghana</p></div></div></div><div class=\"invite-fade flex items-center justify-center gap-3 print:hidden\" style=\"animation-delay:380ms\" aria-hidden=\"true\"><span class=\"h-px w-10 bg-[#c9a866]\"></span><span class=\"w-1.5 h-1.5 rotate-45 bg-[#b98b2e]\"></span><span class=\"h-px w-10 bg-[#c9a866]\"></span></div><div class=\"invite-fade space-y-5 print:hidden\" style=\"animation-delay:460ms\"><p class=\"text-xs tracking-[0.18em] uppercase text-[#6b6154]\">Kindly respond at your earliest convenience</p><p class=\"text-sm text-[#6b6154] leading-relaxed max-w-md mx-auto font-light\">Even if you can&#x27;t make it, please RSVP so we can plan accordingly — we&#x27;d love to know either way.</p><a class=\"invite-rsvp inline-flex\" href=\"/#rsvp\">RSVP now</a><p class=\"text-[10px] text-[#6b6154]/80 break-all px-2 tracking-wide\">https://seguamour.com/#rsvp</p></div><p class=\"text-[10px] tracking-[0.15em] uppercase text-[#6b6154] print:block hidden\">Please RSVP via the wedding website</p></div></article></div><!--$--><!--/$--></div><script src=\"/_next/static/chunks/2zjueh7t2vecu.js\" id=\"_R_\" async=\"\"></script><script>(self.__next_f=self.__next_f||[]).push([0])</script><script>self.__next_f.push([1,\"1:\\\"$Sreact.fragment\\\"\\n2:I[19133,[\\\"/_next/static/chunks/1hwbyymzduhm9.js\\\",\\\"/_next/static/chunks/3rxsc4xc2zpkk.js\\\"],\\\"LanguageProvider\\\"]\\n3:I[42364,[\\\"/_next/static/chunks/1hwbyymzduhm9.js\\\",\\\"/_next/static/chunks/3rxsc4xc2zpkk.js\\\"],\\\"default\\\"]\\n4:I[39756,[\\\"/_next/static/chunks/1hwbyymzduhm9.js\\\",\\\"/_next/static/chunks/3rxsc4xc2zpkk.js\\\"],\\\"default\\\"]\\n5:I[37457,[\\\"/_next/static/chunks/1hwbyymzduhm9.js\\\",\\\"/_next/static/chunks/3rxsc4xc2zpkk.js\\\"],\\\"default\\\"]\\n7:I[97367,[\\\"/_next/static/chunks/1hwbyymzduhm9.js\\\",\\\"/_next/static/chunks/3rxsc4xc2zpkk.js\\\"],\\\"OutletBoundary\\\"]\\n8:\\\"$Sreact.suspense\\\"\\nb:I[97367,[\\\"/_next/static/chunks/1hwbyymzduhm9.js\\\",\\\"/_next/static/chunks/3rxsc4xc2zpkk.js\\\"],\\\"ViewportBoundary\\\"]\\nd:I[97367,[\\\"/_next/static/chunks/1hwbyymzduhm9.js\\\",\\\"/_next/static/chunks/3rxsc4xc2zpkk.js\\\"],\\\"MetadataBoundary\\\"]\\nf:I[68027,[\\\"/_next/static/chunks/1hwbyymzduhm9.js\\\",\\\"/_next/static/chunks/3rxsc4xc2zpkk.js\\\"],\\\"default\\\",1]\\n11:I[77613,[\\\"/_next/static/chunks/1hwbyymzduhm9.js\\\",\\\"/_next/static/chunks/3rxsc4xc2zpkk.js\\\",\\\"/_next/static/chunks/2-ad6ibyefww-.js\\\"],\\\"default\\\"]\\n12:I[27201,[\\\"/_next/static/chunks/1hwbyymzduhm9.js\\\",\\\"/_next/static/chunks/3rxsc4xc2zpkk.js\\\"],\\\"IconMark\\\"]\\n:HL[\\\"/_next/static/chunks/2sxyep-vyrbyn.css\\\",\\\"style\\\"]\